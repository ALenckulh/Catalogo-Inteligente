# Copie este arquivo para `.env` e ajuste os valores conforme necessário.
# O arquivo `.env` NÃO deve ser commitado (já está no .gitignore).

# PostgreSQL
POSTGRES_DB=catalogo
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=catalogo

# RabbitMQ (backend Spring)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# pgAdmin (opcional — só sobe com --profile tools)
PGADMIN_EMAIL=admin@catalogo.local
PGADMIN_PASSWORD=admin

